# ─────────────────────────────────────────────
# Kal AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Supabase ──────────────────────────────────
# Your Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=

# JWT secret used to verify user tokens (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET=

# Service role key for server-side operations (Settings → API → service_role)
# ⚠️  Keep this secret — it bypasses Row Level Security
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini AI ──────────────────────────
# API key from Google Cloud Console (APIs & Services → Credentials)
# Used for AI-powered food photo analysis via Gemini 2.0 Flash
GEMINI_API_KEY=

# ── Rate Limiting ─────────────────────────────
# Redis connection URL for distributed rate limiting across multiple instances.
# Omit or leave empty to use in-memory rate limiting (single instance only).
# Example: redis://localhost:6379  or  redis://:password@host:6379
REDIS_URL=

# ── CORS ──────────────────────────────────────
# Production frontend URL added to the CORS allowlist.
# Example: https://your-app.vercel.app
FRONTEND_URL=

# ── Flask ─────────────────────────────────────
# Set to "production" to disable debug mode and enable production logging.
FLASK_ENV=development

# Port the Flask server listens on (Railway sets this automatically).
PORT=5000
